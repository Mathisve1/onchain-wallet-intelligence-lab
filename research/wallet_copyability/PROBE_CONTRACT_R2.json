    "timeout_seconds": 20,
    "maximum_response_bytes": 5000000,
    "maximum_retries": 1,
    "retry_backoff_ms": 750,
    "retryable_statuses": [429, 500, 502, 503, 504],
    "inter_request_delay_ms": 150,
    "selected_response_headers": [
      "content-length",
      "content-type",
      "x-amz-request-id"
