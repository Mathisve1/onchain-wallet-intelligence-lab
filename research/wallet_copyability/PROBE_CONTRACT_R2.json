    "maximum_schema_depth": 5,
    "maximum_schema_paths": 200,
    "probe_run_declared_base_weight_ceiling": 100
  },
  "fixed_addresses": {
    "master": "0x8c967e73e6b15087c42a10d344cff4c96d877f1d",
    "subaccount": "0x035605fc2f24d65300227189025e90a0d947f16c",
    "vault": "0xdfc24b077bc1425ad1dea75bcb6f8158e10df303"
  },
  "fixed_time_windows": {
    "relative_account_window_hours": 24,
    "archive_probe_day_utc": {
      "year": 2025,
      "month": 1,
      "day": 1
    }
  },
  "retention_policy": {
    "raw_response_bytes_retained": false,
    "response_values_retained": false,
    "response_hash_retained": true,
    "structural_fingerprint_retained": true,
    "aggregate_counts_retained": true,
    "aggregate_timestamp_bounds_retained": true
  },
  "execution_boundary": {
    "read_only": true,
    "credentials_allowed": false,
    "authorization_headers_allowed": false,
    "environment_secrets_allowed": false,
    "private_keys_allowed": false,
    "signed_actions_allowed": false,
    "exchange_action_endpoint_allowed": false,
    "orders_allowed": false,
    "withdrawals_allowed": false
