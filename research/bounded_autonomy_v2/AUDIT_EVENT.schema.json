{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owil:bounded-autonomy:audit-event:0.1",
  "title": "Append-only bounded autonomy audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "timestamp_ms",
    "event_type",
    "action_id",
    "permit_id",
    "payload",
    "previous_event_hash",
    "event_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1-design"},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,180}$"},
    "timestamp_ms": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "pattern": "^[A-Z0-9_]{2,100}$"},
    "action_id": {"type": ["string", "null"]},
    "permit_id": {"type": ["string", "null"]},
    "payload": {"type": "object"},
    "previous_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
