{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowNodeDataExactPrefixListing",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::hl-mainnet-node-data",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "node_fills_by_block/*",
            "node_fills/*",
            "node_trades/*",
            "explorer_blocks/*",
            "replica_cmds/*"
          ]
        },
        "NumericLessThanEquals": {
          "s3:max-keys": "1000"
        }
      }
    },
    {
      "Sid": "AllowArchiveExactPrefixListing",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::hyperliquid-archive",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "market_data/*",
            "asset_ctxs/*"
          ]
        },
        "NumericLessThanEquals": {
          "s3:max-keys": "1000"
        }
      }
    },
    {
      "Sid": "DenyNodeDataPrefixEscape",
      "Effect": "Deny",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::hl-mainnet-node-data",
      "Condition": {
        "StringNotLike": {
          "s3:prefix": [
            "node_fills_by_block/*",
            "node_fills/*",
            "node_trades/*",
            "explorer_blocks/*",
            "replica_cmds/*"
          ]
        }
      }
    },
    {
      "Sid": "DenyArchivePrefixEscape",
      "Effect": "Deny",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::hyperliquid-archive",
      "Condition": {
        "StringNotLike": {
          "s3:prefix": [
            "market_data/*",
            "asset_ctxs/*"
          ]
        }
      }
    },
    {
      "Sid": "DenyOversizeListings",
      "Effect": "Deny",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::hl-mainnet-node-data",
        "arn:aws:s3:::hyperliquid-archive"
      ],
      "Condition": {
        "NumericGreaterThan": {
          "s3:max-keys": "1000"
        }
      }
    },
    {
      "Sid": "DenyVersionListings",
      "Effect": "Deny",
      "Action": "s3:ListBucketVersions",
      "Resource": [
        "arn:aws:s3:::hl-mainnet-node-data",
        "arn:aws:s3:::hyperliquid-archive"
      ]
    },
    {
      "Sid": "DenyAccountWideBucketEnumeration",
      "Effect": "Deny",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "ExplicitlyDenyObjectBodiesAndMutation",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:RestoreObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::hl-mainnet-node-data/*",
        "arn:aws:s3:::hyperliquid-archive/*"
      ]
    }
  ]
}
