    "portfolio_graphs_may_support_shortlisted_wallet_performance_context": true
  },
  "proposed_research_pipeline": [
    {
      "stage": "A_GLOBAL_ARCHIVE_SCREEN",
      "purpose": "scan historical fills population-wide and compute bounded wallet-level candidate features",
      "data_source": "node_fills and node_fills_by_block",
      "per_wallet_api_calls": false,
      "ranking_authorized_by_r8": false
    },
    {
      "stage": "B_CANDIDATE_REDUCTION",
      "purpose": "apply preregistered activity, persistence, data-quality and special-role exclusion rules",
      "data_source": "derived archive statistics",
      "ranking_authorized_by_r8": false
    },
    {
      "stage": "C_SHORTLIST_PUBLIC_API_ENRICHMENT",
      "purpose": "query a reduced candidate set for portfolio/account context, role and other user-specific evidence",
      "data_source": "official public info API",
      "network_authorized_by_r8": false
    },
    {
      "stage": "D_COPYABILITY_EXECUTION_RESEARCH",
      "purpose": "evaluate latency, slippage, liquidity and follower execution after performance evidence exists",
      "data_source": "future market and execution data",
      "network_authorized_by_r8": false
    }
