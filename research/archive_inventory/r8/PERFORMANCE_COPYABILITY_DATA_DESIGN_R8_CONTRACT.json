  "research_question": "What is the smallest defensible data architecture and field set needed to progress from an activity-only Hyperliquid wallet index to historical performance and copyability research without prematurely ranking wallets or over-collecting payload data?",
  "design_objectives": [
    "separate global archive screening from per-wallet API enrichment",
    "freeze a minimum archive field set before broader historical ingestion",
    "distinguish activity and fill-derived statistics from account-return claims",
    "identify modern node_fills_by_block parsing as the first scaling prerequisite",
    "minimize per-wallet API calls and preserve rate-limit headroom",
    "keep entity clustering, copyability scoring, PnL ranking and trading authority closed until separately preregistered"
  ],
  "source_of_truth_priority": [
    "canonical empirical repository evidence",
    "official Hyperliquid node repository and documentation",
    "separately approved future empirical validation"
  ],
